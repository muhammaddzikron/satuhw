rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Members collection
    match /members/{memberId} {
      allow read, write: if true;
    }

    // KTA Applications collection
    match /kta_applications/{appId} {
      allow read, write: if true;
    }

    // Training Applications
    match /training_applications/{appId} {
      allow read, write: if true;
    }

    // HW Activities collection
    match /hw_activities/{actId} {
      allow read, write: if true;
    }

    // HW Activity Categories collection
    match /hw_activity_categories/{catId} {
      allow read, write: if true;
    }

    // Activity Applications collection
    match /activity_applications/{appId} {
      allow read, write: if true;
    }

    // Materi collection
    match /materi/{materiId} {
      allow read, write: if true;
    }

    // Contents collection
    match /contents/{contentId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Kwarda / Qabilah PTMA Collections
    match /kwarda_ptma_pengurus/{id} {
      allow read, write: if true;
    }

    match /kwarda_ptma_sugli/{id} {
      allow read, write: if true;
    }

    match /kwarda_ptma_qabilah/{id} {
      allow read, write: if true;
    }

    match /kwarda_ptma_kegiatan/{id} {
      allow read, write: if true;
    }

    match /kwarda_ptma_materi/{id} {
      allow read, write: if true;
    }

    match /kwarda_pengurus/{id} {
      allow read, write: if true;
    }

    match /kwarda_sugli/{id} {
      allow read, write: if true;
    }

    match /kwarda_qabilah/{id} {
      allow read, write: if true;
    }

    match /kwarda_kegiatan/{id} {
      allow read, write: if true;
    }

    match /kwarda_materi/{id} {
      allow read, write: if true;
    }

    // Default fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
